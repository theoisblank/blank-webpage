---
import Layout from '../layouts/Layout.astro'
import { Background } from '../components/blank/chrome-surface'
---

<Layout>
  <div class="snap-y">
    <section class="h-screen snap-center">
      <div class="
      relative isolate w-full h-full flex flex-col items-center justify-center
      bg-black
    ">
      <div class="pointer-events-none absolute inset-0">
        <Background client:load />
      </div>
      
      <div class="relative z-10 w-full max-w-300 px-20 gap-8 flex flex-col">
        <div class="w-full flex flex-col items-center md:items-start">
          <h1 class="p-0 m-0 text-6xl md:text-8xl lg:text-[10rem] tracking-tighter font-black uppercase leading-none">
            Blank
          </h1>
          <h2 class="p-0 px-8 m-0 text-xl md:text-2xl lg:text-[2rem] tracking-tight font-extrabold leading-none md:-mt-1 lg:-mt-2 text-text-muted">
            Off the path.
          </h2>
        </div>
        
        <div class="w-full flex justify-center md:justify-end">
          <p class="max-w-120 text-center md:text-right text-text-muted">
            The Blank Ecosystem, 
            a project centered on absolute order, precision, and the dematerialization 
            of the superfluous. 
            An austere, timeless proposal designed through the logic of 
            the void, speed, and pure sobriety.
          </p>
        </div>
      </div>
    </div>
    </section>
    <section class="h-screen snap-center">
      <div class="m-auto">main</div>
    </section>
    <section class="h-[calc(100dvh/3)] snap-center">
      <div class="m-auto">footer</div>
    </section>
  </div>
</Layout>